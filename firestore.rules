rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and authorization
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "girmaeden37@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Users Collection
    // - Users can read/create their own profile.
    // - Users can update profile details (KYC, name, etc.) but cannot modify protected fields (balance, role, tradeAction).
    // - Admins have full access.
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());

      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.balance == resource.data.balance &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.tradeAction == resource.data.tradeAction
      );

      allow delete: if isAdmin();
    }

    // 2. Transactions Collection (Deposits, Withdrawals, Trades)
    // - Users can create and read their own transaction records.
    // - Only administrators can approve, reject, update, or delete transactions.
    match /transactions/{transactionId} {
      allow get, list: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );

      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // 3. Support Messages Collection (Direct Messaging between Users and Administrators)
    // - Users can read and create messages belonging to their conversation (userId == request.auth.uid).
    // - Administrators can read, list, create (admin replies to any user conversation), update, and delete all messages.
    match /support_messages/{messageId} {
      allow get, list: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );

      allow create: if isSignedIn() && (
        isAdmin() || 
        request.resource.data.userId == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }

    // 4. Settings Collection
    // - Public read access for global platform configuration and deposit wallet addresses.
    // - Admin-only write access.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
